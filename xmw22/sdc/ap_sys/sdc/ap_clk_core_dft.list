if {![info exist DESIGN(dft,clk_hier)]} {
    set DESIGN(dft,clk_hier) "u_ap_clk_core_wrap/u_ap_clk_core/"
}

set DESIGN(mbist,pin,cons0) [list \
    $DESIGN(dft,clk_hier)u_cmind_clk_sw5_clk_ap_ahb/u_cmind_cell_icg_clk_in0/cmind_uj_ckcell/Q \
    $DESIGN(dft,clk_hier)u_cmind_clk_sw5_clk_ap_ahb/u_cmind_cell_icg_clk_in1/cmind_uj_ckcell/Q \
    $DESIGN(dft,clk_hier)u_cmind_clk_sw5_clk_ap_ahb/u_cmind_cell_icg_clk_in2/cmind_uj_ckcell/Q \
    $DESIGN(dft,clk_hier)u_cmind_clk_sw5_clk_ap_ahb/u_cmind_cell_icg_clk_in3/cmind_uj_ckcell/Q \
    $DESIGN(dft,clk_hier)u_cmind_clk_sw4_clk_spi_flash/u_cmind_cell_icg_clk_in0/cmind_uj_ckcell/Q \
    $DESIGN(dft,clk_hier)u_cmind_clk_sw4_clk_spi_flash/u_cmind_cell_icg_clk_in1/cmind_uj_ckcell/Q \
    $DESIGN(dft,clk_hier)u_cmind_clk_sw4_clk_spi_flash/u_cmind_cell_icg_clk_in2/cmind_uj_ckcell/Q \
]

set DESIGN(mbist,pin,cons1) [list \
    $DESIGN(dft,clk_hier)u_cmind_clk_sw5_clk_ap_ahb/u_cmind_cell_icg_clk_in4/cmind_uj_ckcell/E \
    $DESIGN(dft,clk_hier)u_cmind_clk_sw4_clk_spi_flash/u_cmind_cell_icg_clk_in3/cmind_uj_ckcell/E \
]

set DESIGN(occ_clock_list) [list \
    standard clk_ap_apb $DESIGN(dft,clk_hier)u_clk_ap_apb_occ_buf/cmind_uj_ckcell/I \
    standard clk_ap_ahb $DESIGN(dft,clk_hier)u_clk_ap_ahb_occ_buf/cmind_uj_ckcell/I \
    standard clk_spi0_apb $DESIGN(dft,clk_hier)u_clk_spi0_apb_occ_buf/cmind_uj_ckcell/I \
    standard clk_spi1_apb $DESIGN(dft,clk_hier)u_clk_spi1_apb_occ_buf/cmind_uj_ckcell/I \
    standard clk_spi2_apb $DESIGN(dft,clk_hier)u_clk_spi2_apb_occ_buf/cmind_uj_ckcell/I \
    standard clk_spi_flash $DESIGN(dft,clk_hier)u_clk_spi_flash_occ_buf/cmind_uj_ckcell/I \
    standard clk_uart1 $DESIGN(dft,clk_hier)u_clk_uart1_occ_buf/cmind_uj_ckcell/I \
    standard clk_uart4 $DESIGN(dft,clk_hier)u_clk_uart4_occ_buf/cmind_uj_ckcell/I \
    standard clk_uart5 $DESIGN(dft,clk_hier)u_clk_uart5_occ_buf/cmind_uj_ckcell/I \
    standard clk_i2c1_apb $DESIGN(dft,clk_hier)u_clk_i2c1_apb_occ_buf/cmind_uj_ckcell/I \
    standard clk_i2c2_apb $DESIGN(dft,clk_hier)u_clk_i2c2_apb_occ_buf/cmind_uj_ckcell/I \
    standard clk_i2s0 $DESIGN(dft,clk_hier)u_clk_i2s0_occ_buf/cmind_uj_ckcell/I \
    standard clk_can0_apb $DESIGN(dft,clk_hier)u_clk_can0_apb_occ_buf/cmind_uj_ckcell/I \
    standard clk_can1_apb $DESIGN(dft,clk_hier)u_clk_can1_apb_occ_buf/cmind_uj_ckcell/I \
    standard clk_sdio0 $DESIGN(dft,clk_hier)u_clk_sdio0_occ_buf/cmind_uj_ckcell/I \
    standard clk_sim0_apb $DESIGN(dft,clk_hier)u_clk_sim0_apb_occ_buf/cmind_uj_ckcell/I \
    standard clk_sim1_apb $DESIGN(dft,clk_hier)u_clk_sim1_apb_occ_buf/cmind_uj_ckcell/I \
    standard utmi_clk $DESIGN(dft,clk_hier)u_utmi_clk_occ_buf/cmind_uj_ckcell/I \
    standard clk_top_ahb_scan $DESIGN(dft,clk_hier)u_clk_top_ahb_scan_occ_buf/cmind_uj_ckcell/I \
    standard clk_pub_ahb_scan $DESIGN(dft,clk_hier)u_clk_pub_ahb_scan_occ_buf/cmind_uj_ckcell/I \
    standard clk_sysram_ahb_scan $DESIGN(dft,clk_hier)u_clk_sysram_ahb_scan_occ_buf/cmind_uj_ckcell/I \
    standard ptest_slow_clock $DESIGN(dft,clk_hier)u_ptest_slow_clock_occ_buf/cmind_uj_ckcell/I \
]
