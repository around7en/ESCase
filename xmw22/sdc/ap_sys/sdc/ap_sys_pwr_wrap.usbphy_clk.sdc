####usb phy######

set USB_WRAP_HIER ${AP_SYS_HIER}u_ap_sys_top/u_ap_sys_usb2_wrap
create_clock -name "${AP_SYS_NAME}_SYSCLK240" -period 4 -waveform {0 2} [get_pins "$USB_WRAP_HIER/u_M31USBH225TL022V_00223601/SYSCLK240"]
create_clock -name "${AP_SYS_NAME}_OSC_CLK" -period 25 -waveform {0 12.5} [get_pins "$USB_WRAP_HIER/u_M31USBH225TL022V_00223601/OSC_CLK"]
create_clock -name "${AP_SYS_NAME}_CLKOSCO_U2_240M_CAL" -period 25 -waveform {0 12.5} [get_pins "$USB_WRAP_HIER/u_M31USBH225TL022V_00223601/CLKOSCO_U2_240M_CAL"]
##duty 45~55
create_clock -name "${AP_SYS_NAME}_PLLCK480M" -period 2 -waveform {0 1} [get_pins "$USB_WRAP_HIER/u_M31USBH225TL022V_00223601/PLLCK480M"]
set CLOCK_GROUP(${AP_SYS_NAME}_SYSCLK240)        [list ${AP_SYS_NAME}_SYSCLK240 $USB_WRAP_HIER/u_M31USBH225TL022V_00223601/SYSCLK120 $USB_WRAP_HIER/u_M31USBH225TL022V_00223601/U20_CLK60 $USB_WRAP_HIER/u_M31USBH225TL022V_00223601/U20_CLK30 $USB_WRAP_HIER/u_M31USBH225TL022V_00223601/U20_CLK7p5]
set CLOCK_GROUP(${AP_SYS_NAME}_OSC_CLK)                    [list ${AP_SYS_NAME}_OSC_CLK]
set CLOCK_GROUP(${AP_SYS_NAME}_PLLCK480M)                  [list ${AP_SYS_NAME}_PLLCK480M]
set CLOCK_GROUP(${AP_SYS_NAME}_CLKOSCO_U2_240M_CAL)        [list ${AP_SYS_NAME}_CLKOSCO_U2_240M_CAL $USB_WRAP_HIER/u_M31USBH225TL022V_00223601/CLKOSCO_U2_120M_CAL]
