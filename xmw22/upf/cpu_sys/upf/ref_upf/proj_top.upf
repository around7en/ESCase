upf_version 2.1

create_power_domain PD_TOP -include_scope

#create_power_domain PD1 -elements {u_cpu_sys_top}

create_supply_port VDD -domain PD_TOP -direction in
create_supply_port VSS -domain PD_TOP -direction in

create_supply_net VDD -domain PD_TOP
create_supply_net VSS -domain PD_TOP

connect_supply_net VDD -port VDD
connect_supply_net VSS -port VSS

set_domain_supply_net PD_TOP -primary_power_net VDD -primary_ground_net VSS

add_port_state VDD -state {VDDNOR 0.8} -state {VDDOFF off}
add_port_state VSS -state {VSSON 0.0}

create_pst top_pst -supplies {VDD VSS}
add_pst_state pst_pd_on  -pst top_pst -state {VDDNOR VSSON}
add_pst_state pst_pd_off -pst top_pst -state {VDDOFF VSSON}

